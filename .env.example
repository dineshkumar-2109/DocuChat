# Copy to .env for local development. On Vercel, set these in
# Project → Settings → Environment Variables instead (see DEPLOY.md).

# --- Required ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
# Neon → Connect → "Pooled connection" string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
PINECONE_API_KEY=your_pinecone_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# --- Optional (defaults shown) ---
# PORT=3000
# ANTHROPIC_MODEL=claude-sonnet-5-5
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
# PINECONE_INDEX=docuchat
# ANSWER_CACHE_TTL=86400
# MAX_UPLOAD_MB=4
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# TRUST_PROXY=1
# PG_POOL_MAX=5
